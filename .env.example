# Event Platform Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# PUBLIC VARIABLES (exposed to browser)
# =============================================================================

# Base URL for the application (used for canonical URLs, OG tags, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Supabase URL (for image delivery / transforms)
# Local: http://127.0.0.1:54321
# Production: https://[PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# =============================================================================
# SERVER-ONLY VARIABLES (never exposed to browser)
# =============================================================================

# Database (Supabase Postgres)
# Pooled connection string (for application queries)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true
# Direct connection string (for migrations)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase Storage (privileged server-side access for media uploads)
# Production: the service_role key from your Supabase project's API settings
# — NEVER expose to the client and NEVER commit a real key.
# Local dev with `supabase start`: the CLI ships a fixed demo project whose
# service_role key is a public, well-known constant. Paste this into your
# .env.local to enable media uploads against the local Supabase instance:
#   eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# LOCAL DEVELOPMENT (Supabase Local)
# =============================================================================

# For local development with Supabase (npm run supabase:start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# =============================================================================
# LOCAL DEVELOPMENT (Mailpit SMTP)
# =============================================================================

# Set SMTP_HOST to use Mailpit instead of Mailgun for local email testing
# Start Mailpit first with: npm run mailpit (or docker)
# View emails at: http://localhost:8025
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# Firebase Admin SDK (not needed when using emulator with demo project)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Replace \n with actual newlines in your .env.local
FIREBASE_PRIVATE_KEY=

# =============================================================================
# LOCAL DEVELOPMENT (Firebase Emulator)
# =============================================================================

# Set these to use Firebase Auth Emulator instead of production Firebase
# Start emulator first with: npm run emulators
# Then start dev server with: npm run dev:local
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Mailgun (transactional email)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.eventfxr.com
# Use https://api.mailgun.net for US, https://api.eu.mailgun.net for EU
MAILGUN_REGION_BASE_URL=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
MAIL_FROM=Events <noreply@eventfxr.com>

# =============================================================================
# CRON JOBS (Vercel Cron)
# =============================================================================

# Secret for authenticating Vercel Cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=

# =============================================================================
# PUBLIC PORTAL RSVP
# =============================================================================

# Server-side pepper for HMAC-hashing public-portal RSVP codes. Required.
# Treat as a long-lived secret — rotating invalidates every issued code.
# Generate with: openssl rand -base64 32
RSVP_CODE_HMAC_KEY=

# =============================================================================
# POST-EVENT GALLERY
# =============================================================================

# Feature flag for the post-event gallery rollout. Set BOTH vars below to
# "true" to enable. The non-public var gates server routes / pages; the
# NEXT_PUBLIC_* var gates client-side UI affordances (e.g. the dashboard
# Gallery button). Server routes always re-check, so the public flag is
# purely for hiding UI when the feature is off.
POST_EVENT_GALLERY_ENABLED=
NEXT_PUBLIC_POST_EVENT_GALLERY_ENABLED=

# AES-256-GCM key used to encrypt OAuth refresh/access tokens stored in the
# provider_tokens table. Base64-encoded 32 bytes. Rotating this key
# invalidates every stored token, forcing organizers to reconnect their
# provider — no data loss, just a re-auth prompt.
# Generate with: openssl rand -base64 32
PROVIDER_TOKEN_ENCRYPTION_KEY=

# HMAC key for signing the OAuth state cookie set during the Google Drive
# connect flow. Distinct from PROVIDER_TOKEN_ENCRYPTION_KEY so a
# state-cookie compromise doesn't imply token-store compromise.
# Base64-encoded ≥32 bytes. Generate with: openssl rand -base64 32
OAUTH_STATE_SIGNING_KEY=

# Google Drive OAuth credentials (Google Cloud Console → OAuth client ID →
# Web application). Add the callback URL
# ${NEXT_PUBLIC_BASE_URL}/api/auth/google-drive/callback to the Authorized
# redirect URIs list. Required scope: drive.file (non-sensitive — no Google
# security review needed). Only needed once an organizer attempts to
# connect Drive; the connect route returns 503 with a clear error if unset.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error Tracking (Sentry)
SENTRY_DSN=

# Allow /test/* routes in production builds (set to any non-empty value to enable)
# ALLOW_TEST_ROUTES=1

# =============================================================================
# GEOCODING (Phase 3 — LocationIQ, server-side only)
# =============================================================================
# Default is "none" — local dev / CI / preview deploys get the NoopGeocoder
# that returns empty candidate lists, so the editor shows "No matches" when
# Find Location is clicked and manual lat/lng entry still works. Production
# sets GEOCODER_PROVIDER=locationiq + LOCATIONIQ_API_KEY. Preview deploys
# stay on "none" so they don't eat the production quota (LocationIQ free tier
# permits one access token, shared across all envs).
#
# To test the real geocode flow locally, sign up at https://locationiq.com/
# (free tier: 5k requests/day) and set both vars below.
GEOCODER_PROVIDER=
LOCATIONIQ_API_KEY=
